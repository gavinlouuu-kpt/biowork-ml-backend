# Basic auth for model server (optional)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Logging
LOG_LEVEL=DEBUG

# Docker/Gunicorn settings
WORKERS=1
THREADS=8
TEST_ENV=

# Model configuration
MODEL_DIR=/data/models
PYTHONPATH=/app
MODEL_ROOT=/app/models

# YOLO-specific parameters
ALLOW_CUSTOM_MODEL_PATH=true
DEBUG_PLOT=false
MODEL_SCORE_THRESHOLD=0.5

# YOLO training parameters
YOLO_TRAIN_PROJECT_ROOT=/data/server/yolo_autotrain
YOLO_TRAIN_EPOCHS=25
YOLO_TRAIN_IMGSZ=1024
YOLO_TRAIN_BATCH=8
YOLO_TRAIN_WORKERS=2
YOLO_TRAIN_PATIENCE=20
YOLO_TRAIN_BASE_MODEL_DETECT=yolov8m.pt
YOLO_TRAIN_BASE_MODEL_SEGMENT=yolov8n-seg.pt

# MLflow model/training registry.
# Metadata is stored on the persisted training volume; artifacts are stored in RustFS.
YOLO_TRAIN_MLFLOW_ENABLED=true
YOLO_TRAIN_MLFLOW_EXPERIMENT=biowork-yolo-training
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_ARTIFACT_ROOT=mlflow-artifacts:/biowork
MLFLOW_S3_ENDPOINT_URL=https://rustfs-api.himalayan-coho.ts.net
AWS_ENDPOINT_URL=https://rustfs-api.himalayan-coho.ts.net
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Label Studio access (fallback, middleware preferred)
LABEL_STUDIO_HOST=http://label-studio-app-dev:8000
LABEL_STUDIO_API_KEY=

# Organization middleware (automatic token resolution from Label Studio DB)
USE_ORG_MIDDLEWARE=true
LABEL_STUDIO_DB_TYPE=postgres
LABEL_STUDIO_DB_PATH=
LABEL_STUDIO_DB_HOST=db-dev
LABEL_STUDIO_DB_PORT=5432
LABEL_STUDIO_DB_NAME=postgres
LABEL_STUDIO_DB_USER=postgres
LABEL_STUDIO_DB_PASSWORD=postgres
